generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ===== ENUMS =====
// Role enum removed for SQLite compatibility

// ===== ORGANIZATION MODEL =====

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  users  User[]
  events Event[]
}

// ===== AUTH MODELS =====

model User {
  id                      String        @id @default(uuid())
  name                    String
  email                   String        @unique
  password                String        // bcrypt hash (12 rounds)
  role                    String        @default("EVENT_MANAGER")
  organization_id         String?
  profile_image           String?
  ai_chat_history         String?
  
  organization            Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  is_active               Boolean       @default(true)
  is_verified             Boolean       @default(false)
  verification_token      String?       @unique
  verification_expires_at DateTime?
  password_reset_token    String?       @unique
  password_reset_expires  DateTime?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  sessions     Session[]
  event_access EventAccess[]
}

model OtpVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String
  is_verified Boolean @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
}

model Session {
  id            String   @id @default(uuid())
  user_id       String
  refresh_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  user_agent    String?
  ip_address    String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model EventAccess {
  id       String @id @default(uuid())
  user_id  String
  event_id String

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
}

// ===== EVENT MODELS =====

model Event {
  id              String    @id @default(uuid())
  organization_id String?
  title           String

  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  date_time       DateTime
  venue           String
  ticket_price    Float
  total_capacity  Int
  available_slots Int
  image           String?
  tiers           String?
  customFormFields String?
  smtp_config     String?
  page_config     String?
  upi_config      String?

  tickets      Ticket[]
  event_access EventAccess[]
}

model Ticket {
  id              String   @id @default(uuid())
  event_id        String
  attendee_name   String
  student_roll_no String
  attendee_email  String?
  attendee_phone  String?
  tier_id         String?
  tier_name       String?
  custom_data     String?
  payment_screenshot String?
  exit_image      String?
  status          String   @default("OUTSIDE")
  in_time         DateTime?
  temp_out_time   DateTime?
  temp_in_time    DateTime?
  out_time        DateTime?
  created_at      DateTime @default(now())

  event           Event          @relation(fields: [event_id], references: [id])
  attendance_logs AttendanceLog[]
}

model AttendanceLog {
  id                 Int      @id @default(autoincrement())
  ticket_id          String
  action_type        String   // "ENTRY", "DENIED", "TEMPORARY_EXIT_CHECK"
  timestamp          DateTime @default(now())
  roll_number        String?
  captured_photo_url String?

  ticket Ticket @relation(fields: [ticket_id], references: [id])
}
